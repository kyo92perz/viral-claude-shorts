{
 "duration": 116.012,
 "phrases": [
  {
   "n": 1,
   "t0": 0,
   "t1": 1.6,
   "from": 0,
   "to": 4,
   "text": "Três e sete da manhã,",
   "question": false
  },
  {
   "n": 2,
   "t0": 1.92,
   "t1": 3.5,
   "from": 5,
   "to": 8,
   "text": "Black Hollow, Virginia, Ocidental.",
   "question": false
  },
  {
   "n": 3,
   "t0": 3.88,
   "t1": 7.32,
   "from": 9,
   "to": 20,
   "text": "Eu trabalho no único posto vinte e quatro horas da rota nove.",
   "question": false
  },
  {
   "n": 4,
   "t0": 7.74,
   "t1": 10.66,
   "from": 21,
   "to": 32,
   "text": "E essa foi a noite em que os mortos voltaram pra abastecer.",
   "question": false
  },
  {
   "n": 5,
   "t0": 11.26,
   "t1": 12.44,
   "from": 33,
   "to": 37,
   "text": "Meu nome é Lola Reis.",
   "question": false
  },
  {
   "n": 6,
   "t0": 12.9,
   "t1": 17.6,
   "from": 38,
   "to": 52,
   "text": "Dois anos de exército, seis meses de terapia, e agora eu vendo salgadinho pra caminhoneiro.",
   "question": false
  },
  {
   "n": 7,
   "t0": 18,
   "t1": 21.48,
   "from": 53,
   "to": 65,
   "text": "Bem -vindos a mais um verdade oca, o podcast com onze ou vintes.",
   "question": false
  },
  {
   "n": 8,
   "t0": 21.84,
   "t1": 23,
   "from": 66,
   "to": 71,
   "text": "Doze se a minha mãe voltar.",
   "question": false
  },
  {
   "n": 9,
   "t0": 23.42,
   "t1": 25.82,
   "from": 72,
   "to": 79,
   "text": "Tobby, você tá gravando no estoque de novo.",
   "question": false
  },
  {
   "n": 10,
   "t0": 25.82,
   "t1": 27.78,
   "from": 80,
   "to": 85,
   "text": "Lola, hoje é 13 de novembro.",
   "question": false
  },
  {
   "n": 11,
   "t0": 28,
   "t1": 29.62,
   "from": 86,
   "to": 90,
   "text": "Aniversário do desabamento da mina.",
   "question": false
  },
  {
   "n": 12,
   "t0": 29.98,
   "t1": 31.94,
   "from": 91,
   "to": 97,
   "text": "Dizem que nessa noite os mineiros voltam.",
   "question": false
  },
  {
   "n": 13,
   "t0": 32.44,
   "t1": 36.04,
   "from": 98,
   "to": 111,
   "text": "Eu ri até a neblina engolir a estrada inteira em menos de um minuto.",
   "question": false
  },
  {
   "n": 14,
   "t0": 36.62,
   "t1": 38.52,
   "from": 112,
   "to": 119,
   "text": "Toc toc toc tinha um homem no vidro.",
   "question": false
  },
  {
   "n": 15,
   "t0": 38.84,
   "t1": 42.02,
   "from": 120,
   "to": 127,
   "text": "Capacete de mineiro, lanterna apagada, pele cinza molhada.",
   "question": false
  },
  {
   "n": 16,
   "t0": 42.6,
   "t1": 43.16,
   "from": 128,
   "to": 128,
   "text": "Tobias,",
   "question": false
  },
  {
   "n": 17,
   "t0": 43.48,
   "t1": 44,
   "from": 129,
   "to": 130,
   "text": "eu vovô.",
   "question": false
  },
  {
   "n": 18,
   "t0": 44.22,
   "t1": 44.94,
   "from": 131,
   "to": 133,
   "text": "Abre a porta.",
   "question": false
  },
  {
   "n": 19,
   "t0": 45.3,
   "t1": 46.36,
   "from": 134,
   "to": 137,
   "text": "Tá frio aqui fora.",
   "question": false
  },
  {
   "n": 20,
   "t0": 47.02,
   "t1": 49.72,
   "from": 138,
   "to": 147,
   "text": "Lola, meu avô morreu naquela mina, em oitenta e sete.",
   "question": false
  },
  {
   "n": 21,
   "t0": 49.72,
   "t1": 56.42,
   "from": 148,
   "to": 167,
   "text": "Parois, o xerife Arl Hatcher estacionou, desceu com a lanterna, e o homem no vidro simplesmente não estava mais lá.",
   "question": false
  },
  {
   "n": 22,
   "t0": 56.76,
   "t1": 58.86,
   "from": 168,
   "to": 174,
   "text": "Vocês dois tão vendo fantasma de novo,",
   "question": false
  },
  {
   "n": 23,
   "t0": 59.18,
   "t1": 61.72,
   "from": 175,
   "to": 183,
   "text": "me dá um café, sem açúcar e sem história.",
   "question": false
  },
  {
   "n": 24,
   "t0": 62.16,
   "t1": 64.42,
   "from": 184,
   "to": 194,
   "text": "Mas o Arl não tirou a mão do revolver nenhuma vez,",
   "question": false
  },
  {
   "n": 25,
   "t0": 64.9,
   "t1": 67.72,
   "from": 195,
   "to": 204,
   "text": "e aí o deio entrou, caminhoneiro, cliente de toda noite.",
   "question": false
  },
  {
   "n": 26,
   "t0": 68.18,
   "t1": 70.44,
   "from": 205,
   "to": 213,
   "text": "Só que hoje ele andava torto e sorria demais.",
   "question": false
  },
  {
   "n": 27,
   "t0": 71.02,
   "t1": 73.1,
   "from": 214,
   "to": 219,
   "text": "Lola, a mina tá com fome.",
   "question": false
  },
  {
   "n": 28,
   "t0": 73.68,
   "t1": 77.42,
   "from": 220,
   "to": 233,
   "text": "Ele agarrou meu colarinho com as duas mãos e me jogou contra a prateleira.",
   "question": false
  },
  {
   "n": 29,
   "t0": 77.42,
   "t1": 81.64,
   "from": 234,
   "to": 246,
   "text": "Eu torci o punho dele pra fora, cotovelo na mandíbula, joelho no estômago.",
   "question": false
  },
  {
   "n": 30,
   "t0": 82.02,
   "t1": 83.3,
   "from": 247,
   "to": 250,
   "text": "Qualquer homem teria caído,",
   "question": false
  },
  {
   "n": 31,
   "t0": 83.72,
   "t1": 84.2,
   "from": 251,
   "to": 253,
   "text": "o deio rio.",
   "question": false
  },
  {
   "n": 32,
   "t0": 84.56,
   "t1": 86.24,
   "from": 254,
   "to": 260,
   "text": "Ele me ergueu do chão pelo pescoço.",
   "question": false
  },
  {
   "n": 33,
   "t0": 86.66,
   "t1": 90.5,
   "from": 261,
   "to": 276,
   "text": "Eu chutei o joelho dele de lado, ouvi estalar e bati a cabeça dele no balcão.",
   "question": false
  },
  {
   "n": 34,
   "t0": 90.66,
   "t1": 91.5,
   "from": 277,
   "to": 279,
   "text": "Uma vez, duas.",
   "question": false
  },
  {
   "n": 35,
   "t0": 91.82,
   "t1": 93.98,
   "from": 280,
   "to": 287,
   "text": "Ele não sangrou o sangue, sangrou o carvão.",
   "question": false
  },
  {
   "n": 36,
   "t0": 94.28,
   "t1": 95.3,
   "from": 288,
   "to": 291,
   "text": "Sai de perto dela.",
   "question": false
  },
  {
   "n": 37,
   "t0": 95.68,
   "t1": 99.22,
   "from": 292,
   "to": 305,
   "text": "O tobe, o maior covarde que eu conheço, acertou o extintor na nuca dele.",
   "question": false
  },
  {
   "n": 38,
   "t0": 99.5,
   "t1": 101.7,
   "from": 306,
   "to": 313,
   "text": "O deio caiu e o xerife ficou branco.",
   "question": false
  },
  {
   "n": 39,
   "t0": 102,
   "t1": 102.94,
   "from": 314,
   "to": 318,
   "text": "Isso não é o deio?",
   "question": true
  },
  {
   "n": 40,
   "t0": 103.14,
   "t1": 103.92,
   "from": 319,
   "to": 322,
   "text": "Isso é um oco.",
   "question": false
  },
  {
   "n": 41,
   "t0": 103.92,
   "t1": 108.58,
   "from": 323,
   "to": 338,
   "text": "Foi aí que a luz apagou e alguém bateu em todas as janelas ao mesmo tempo.",
   "question": false
  },
  {
   "n": 42,
   "t0": 109.24,
   "t1": 109.8,
   "from": 339,
   "to": 339,
   "text": "Lola,",
   "question": false
  },
  {
   "n": 43,
   "t0": 110.08,
   "t1": 110.62,
   "from": 340,
   "to": 340,
   "text": "abris.",
   "question": false
  },
  {
   "n": 44,
   "t0": 111.26,
   "t1": 112.7,
   "from": 341,
   "to": 346,
   "text": "Era a voz do meu irmão,",
   "question": false
  },
  {
   "n": 45,
   "t0": 113.04,
   "t1": 114.28,
   "from": 347,
   "to": 350,
   "text": "ele morreu no Afeganistão.",
   "question": false
  }
 ],
